{
  "name": "rststore",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/GrandDuke038/rststore#readme",
  "bugs": {
    "url": "https://github.com/GrandDuke038/rststore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrandDuke038/rststore.git"
  },
  "license": "UNLICENSED",
  "author": "Isaac",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node server/main.js",
    "server": "nodemon --watch server server/main.js",
    "client": " npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node server/seeder",
    "data:destroy": "node server/seeder -d"
  },
  "imports": {
    "#config/*": "./server/config/*",
    "#data/*": "./server/data/*",
    "#models/*": "./server/models/*",
    "#routes/*": "./server/routes/*",
    "#middlewares/*": "./server/middlewares/*",
    "#controllers/*": "./server/controllers/*",
    "#utils/*": "./server/utils/*"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14"
  }
}
